# CollabSphere Environment Variables Configuration
# Copy this file to .env for custom configurations

# Backend Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# OpenAlex Scholarly API (Free & Open, email is used for polite pool rate limit)
OPENALEX_MAILTO=collabsphere-student@university.edu

# Spark Configuration
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
